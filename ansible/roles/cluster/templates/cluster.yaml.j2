# SPDX-License-Identifier: Apache-2.0
#
# The cluster, based on CAPM3's clusterctl template: every host in
# capm3_hosts becomes a node, the control-plane hosts through a
# KubeadmControlPlane and the workers through a MachineDeployment, chosen by
# their role label.
#
# No Metal3DataTemplate: the hosts get their addresses from DHCP, and BMO's
# config drive already carries the host's name and UID, which kubeadm reads
# below (cloud-init renders ds.meta_data). CAPM3 matches each Node to its
# host by the metal3.io/uuid label.
{% set ds_name = '{{ ds.meta_data.name }}' %}
{% set ds_uuid_label = 'metal3.io/uuid={{ ds.meta_data.uuid }}' %}
apiVersion: cluster.x-k8s.io/v1beta2
kind: Cluster
metadata:
  name: "{{ capm3_cluster_name }}"
  namespace: "{{ capm3_namespace }}"
spec:
  clusterNetwork:
    pods:
      cidrBlocks: ["{{ capm3_pod_cidr }}"]
    services:
      cidrBlocks: ["{{ capm3_service_cidr }}"]
  infrastructureRef:
    apiGroup: infrastructure.cluster.x-k8s.io
    kind: Metal3Cluster
    name: "{{ capm3_cluster_name }}"
  controlPlaneRef:
    apiGroup: controlplane.cluster.x-k8s.io
    kind: KubeadmControlPlane
    name: "{{ capm3_cluster_name }}"
---
apiVersion: infrastructure.cluster.x-k8s.io/v1beta1
kind: Metal3Cluster
metadata:
  name: "{{ capm3_cluster_name }}"
  namespace: "{{ capm3_namespace }}"
spec:
  # A single control-plane node at a fixed address: no virtual IP needed.
  controlPlaneEndpoint:
    host: "{{ capm3_control_plane_endpoint }}"
    port: 6443
  cloudProviderEnabled: false
---
apiVersion: controlplane.cluster.x-k8s.io/v1beta2
kind: KubeadmControlPlane
metadata:
  name: "{{ capm3_cluster_name }}"
  namespace: "{{ capm3_namespace }}"
spec:
  replicas: {{ capm3_control_plane_hosts | length }}
  version: "v{{ capm3_kubernetes_version }}"
  machineTemplate:
    spec:
      infrastructureRef:
        apiGroup: infrastructure.cluster.x-k8s.io
        kind: Metal3MachineTemplate
        name: "{{ capm3_cluster_name }}-controlplane"
  # kube-ovn/role=master: Kube-OVN runs OVN central on these nodes.
  kubeadmConfigSpec:
    initConfiguration:
      nodeRegistration:
        name: "{{ ds_name }}"
        kubeletExtraArgs:
          - name: node-labels
            value: "{{ ds_uuid_label }},kube-ovn/role=master"
    joinConfiguration:
      controlPlane: {}
      nodeRegistration:
        name: "{{ ds_name }}"
        kubeletExtraArgs:
          - name: node-labels
            value: "{{ ds_uuid_label }},kube-ovn/role=master"
{% if capm3_ssh_authorized_keys %}
    users:
      - name: "{{ capm3_ssh_user }}"
        sudo: ALL=(ALL) NOPASSWD:ALL
        sshAuthorizedKeys: {{ capm3_ssh_authorized_keys | to_json }}
{% endif %}
---
apiVersion: infrastructure.cluster.x-k8s.io/v1beta1
kind: Metal3MachineTemplate
metadata:
  name: "{{ capm3_cluster_name }}-controlplane"
  namespace: "{{ capm3_namespace }}"
spec:
  nodeReuse: false
  template:
    spec:
      hostSelector:
        matchLabels:
          "{{ capm3_host_role_label }}": control-plane
      automatedCleaningMode: "{{ capm3_automated_cleaning_mode }}"
      image:
        url: "{{ capm3_image_url }}"
        checksum: "{{ capm3_image_checksum_url }}"
        checksumType: "{{ capm3_image_checksum_type }}"
        format: "{{ capm3_image_format }}"
{% if capm3_worker_hosts %}
---
apiVersion: cluster.x-k8s.io/v1beta2
kind: MachineDeployment
metadata:
  name: "{{ capm3_cluster_name }}-workers"
  namespace: "{{ capm3_namespace }}"
spec:
  clusterName: "{{ capm3_cluster_name }}"
  replicas: {{ capm3_worker_hosts | length }}
  selector:
    matchLabels:
      cluster.x-k8s.io/cluster-name: "{{ capm3_cluster_name }}"
      nodepool: workers
  template:
    metadata:
      labels:
        cluster.x-k8s.io/cluster-name: "{{ capm3_cluster_name }}"
        nodepool: workers
    spec:
      clusterName: "{{ capm3_cluster_name }}"
      version: "v{{ capm3_kubernetes_version }}"
      bootstrap:
        configRef:
          apiGroup: bootstrap.cluster.x-k8s.io
          kind: KubeadmConfigTemplate
          name: "{{ capm3_cluster_name }}-workers"
      infrastructureRef:
        apiGroup: infrastructure.cluster.x-k8s.io
        kind: Metal3MachineTemplate
        name: "{{ capm3_cluster_name }}-workers"
---
apiVersion: bootstrap.cluster.x-k8s.io/v1beta2
kind: KubeadmConfigTemplate
metadata:
  name: "{{ capm3_cluster_name }}-workers"
  namespace: "{{ capm3_namespace }}"
spec:
  template:
    spec:
      joinConfiguration:
        nodeRegistration:
          name: "{{ ds_name }}"
          kubeletExtraArgs:
            - name: node-labels
              value: "{{ ds_uuid_label }}"
{% if capm3_ssh_authorized_keys %}
      users:
        - name: "{{ capm3_ssh_user }}"
          sudo: ALL=(ALL) NOPASSWD:ALL
          sshAuthorizedKeys: {{ capm3_ssh_authorized_keys | to_json }}
{% endif %}
---
apiVersion: infrastructure.cluster.x-k8s.io/v1beta1
kind: Metal3MachineTemplate
metadata:
  name: "{{ capm3_cluster_name }}-workers"
  namespace: "{{ capm3_namespace }}"
spec:
  nodeReuse: false
  template:
    spec:
      hostSelector:
        matchLabels:
          "{{ capm3_host_role_label }}": worker
      automatedCleaningMode: "{{ capm3_automated_cleaning_mode }}"
      image:
        url: "{{ capm3_image_url }}"
        checksum: "{{ capm3_image_checksum_url }}"
        checksumType: "{{ capm3_image_checksum_type }}"
        format: "{{ capm3_image_format }}"
{% endif %}
