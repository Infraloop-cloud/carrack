# SPDX-License-Identifier: Apache-2.0
#
# The Bare Metal Operator, configured to take Ironic's endpoint and
# credentials from the Ironic resource (ironic.yaml.j2) managed by
# ironic-standalone-operator.
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
  - https://github.com/metal3-io/baremetal-operator/config/use-irso?ref={{ capm3_bmo_version }}

images:
  - name: quay.io/metal3-io/baremetal-operator
    newTag: "{{ capm3_bmo_version }}"

generatorOptions:
  disableNameSuffixHash: true

# BMO's CRDs aren't installed by clusterctl, which only moves the types it
# knows: these labels make clusterctl move (the pivot role) take every
# BareMetalHost, with its BMC secret, and HardwareData along with the
# cluster. As in metal3-dev-env's pivot.
patches:
  - target:
      kind: CustomResourceDefinition
      name: baremetalhosts.metal3.io
    patch: |-
      apiVersion: apiextensions.k8s.io/v1
      kind: CustomResourceDefinition
      metadata:
        name: baremetalhosts.metal3.io
        labels:
          clusterctl.cluster.x-k8s.io: ""
          clusterctl.cluster.x-k8s.io/move: ""
          clusterctl.cluster.x-k8s.io/move-hierarchy: ""
  - target:
      kind: CustomResourceDefinition
      name: hardwaredata.metal3.io
    patch: |-
      apiVersion: apiextensions.k8s.io/v1
      kind: CustomResourceDefinition
      metadata:
        name: hardwaredata.metal3.io
        labels:
          clusterctl.cluster.x-k8s.io: ""
          clusterctl.cluster.x-k8s.io/move: ""

configMapGenerator:
  - name: ironic
    namespace: "{{ capm3_bmo_namespace }}"
    behavior: merge
    literals:
      - IRONIC_NAMESPACE={{ capm3_bmo_namespace }}
